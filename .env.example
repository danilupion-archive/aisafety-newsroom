# Copy to .env for local development. dbmate and kysely-codegen read DATABASE_URL from .env.
# These are the local, non-secret defaults from compose.yaml.
DATABASE_URL=postgres://newsroom_owner:dev-only-owner@localhost:5433/newsroom?sslmode=disable
# The test database, rebuilt from the migrations on every `pnpm test:db` run.
TEST_DATABASE_URL=postgres://newsroom_owner:dev-only-owner@localhost:5433/newsroom_test?sslmode=disable
TEST_SUPERUSER_DATABASE_URL=postgres://postgres:postgres@localhost:5433/newsroom_test?sslmode=disable
TEST_APP_DATABASE_URL=postgres://newsroom_app:dev-only-app@localhost:5433/newsroom_test?sslmode=disable
# The API and the worker connect as newsroom_app; the API's public read routes as newsroom_public.
APP_DATABASE_URL=postgres://newsroom_app:dev-only-app@localhost:5433/newsroom?sslmode=disable
PUBLIC_DATABASE_URL=postgres://newsroom_public:dev-only-public@localhost:5433/newsroom?sslmode=disable
