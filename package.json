{
  "name": "aisafety-newsroom",
  "private": true,
  "description": "Capture, triage and publishing software for aisafety-media",
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/danilupion/aisafety-newsroom",
  "type": "module",
  "scripts": {
    "clean:node-modules": "clean-node-modules",
    "clean:cache": "clean-cache-artifacts",
    "clean:build": "clean-build-artifacts",
    "clean": "clean-build-artifacts && clean-cache-artifacts && clean-node-modules",
    "dev": "turbo dev build:watch",
    "build": "turbo build",
    "build:check": "turbo build:check",
    "lint": "turbo lint && oxlint --disable-nested-config --max-warnings 0 . && pnpm lint:md",
    "lint:fix": "turbo lint:fix && oxlint --disable-nested-config --fix --max-warnings 0 .",
    "lint:md": "markdownlint-cli2",
    "test": "turbo test",
    "test:db": "turbo test:db",
    "format": "prettier --ignore-unknown --write .",
    "format:check": "prettier --ignore-unknown --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:new": "dbmate --migrations-dir db/migrations new",
    "db:migrate": "dbmate --migrations-dir db/migrations --no-dump-schema up && pnpm db:dump",
    "db:status": "dbmate --migrations-dir db/migrations status",
    "db:dump": "docker exec -i ${NEWSROOM_PG_CONTAINER:-aisafety-newsroom-postgres} sh -c 'PGPASSWORD=\"$POSTGRES_PASSWORD\" pg_dump --schema-only --restrict-key=schema -U postgres -d newsroom' > db/schema.sql",
    "db:types": "kysely-codegen --dialect postgres --include-pattern 'app.*' --out-file packages/db/src/generated/db.ts && prettier --write packages/db/src/generated/db.ts",
    "release:note": "changeset add",
    "release:empty": "changeset add --empty",
    "release:bump": "changeset version",
    "release:check": "changeset status --since=origin/main",
    "prepare": "[ \"$PACKAGED\" = true ] && echo 'Skipping prepare for packaged production dependencies install' || husky",
    "docker:build": "turbo docker:build",
    "docker:push": "turbo docker:push"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@slango.configs/lint-staged": "2.0.9",
    "@slango.configs/oxlint": "0.1.14",
    "@slango.configs/prettier": "1.0.37",
    "@slango.configs/scripts": "1.2.8",
    "dbmate": "2.36.0",
    "husky": "9.1.7",
    "kysely-codegen": "0.20.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "turbo": "2.11.9"
  },
  "engines": {
    "node": "^26.12.0",
    "pnpm": "^12.14.0"
  },
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
