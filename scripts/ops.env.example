# The infrastructure the seal scripts and the runbooks work with. Copy to scripts/ops.env (git ignores it) and fill in
# your own values: these are fictional. KEY=value, one per line; quote a value in single quotes if it holds `$`.
# Nothing here is secret: secrets are typed into the scripts (hidden) and only ever sealed.

# The cluster: kubectl's context, and the namespace and name of the SealedSecrets controller.
KUBE_CONTEXT=example-cluster
SEAL_CONTROLLER_NAMESPACE=example-sealer
SEAL_CONTROLLER_NAME=example-sealer

# Inside the gitops checkout the scripts take as their argument: the app's sealed secrets, its values file, and the
# folder for the database's provisioning secret.
GITOPS_APP_SECRETS_DIR=clusters/example/apps/aisafety-newsroom/secrets
GITOPS_APP_VALUES=clusters/example/values/aisafety-newsroom.yaml
GITOPS_DB_SECRETS_DIR=clusters/example/data/postgres

# The shared Postgres: its namespace and pod (for restores) and the host:port the apps connect to.
DB_NAMESPACE=example-postgres
DB_POD=example-postgres-0
DB_HOST=postgres.example.internal:5432

# The error tracker's in-cluster host: the DSNs are rewritten to it, since the apps report inside the cluster.
ERROR_TRACKING_HOST=errors.example.internal

# The container registry, the robot account the cluster pulls with, the name of the pull secret, and a repository
# the robot must be able to pull (checked before sealing).
REGISTRY=registry.example.test
REGISTRY_PULL_ROBOT='robot$example+pull'
REGISTRY_PULL_SECRET=aisafety-newsroom-registry-pull
REGISTRY_PROBE_REPOSITORY=aisafety-newsroom/migrations

# The public host of the API and the site. The Telegram webhook defaults to $NEWSROOM_URL/telegram/webhook;
# WEBHOOK_URL overrides it.
NEWSROOM_URL=https://newsroom.example.test
